+  gap: 0.9rem;
+  align-items: center;
+  padding: 0.9rem;
+  border: 1px solid var(--vp-c-divider);
+  border-radius: 10px;
+  background: var(--vp-c-bg-soft);
+  transition: border-color 0.2s;
+}
+
+.mem-card:hover {
+  border-color: var(--vp-c-brand-1);
+}
+
+.mem-avatar {
+  flex: 0 0 3rem;
+  width: 3rem;
+  height: 3rem;
+  border-radius: 50%;
+  overflow: hidden;
+  display: grid;
+  place-items: center;
+  background: var(--vp-c-default-soft);
+  color: var(--vp-c-text-2);
